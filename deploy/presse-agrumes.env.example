# Copiez ce fichier en .env (ou utilisez des variables d'environnement
# systemd) et adaptez les chemins.

# Écoute réseau
PA_HOST=0.0.0.0
PA_PORT=8080

# Données de l'application (scans, jobs, tests, benchmarks)
PA_DATA_DIR=/opt/presse-agrumes/data

# Racines auxquelles l'interface peut accéder (séparées par ":")
PA_ALLOWED_ROOTS=/mnt/media:/srv/media

# Authentification HTTP Basic (fortement recommandée hors LAN)
# PA_AUTH_USER=agrumes
# PA_AUTH_PASSWORD=changez-moi

# Binaires ffmpeg/ffprobe si absents du PATH du service
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
