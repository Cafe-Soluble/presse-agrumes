[Unit]
Description=Presse-Agrumes — analyse et compression AV1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adaptez l'utilisateur, le groupe et le chemin d'installation.
User=media
Group=media
WorkingDirectory=/opt/presse-agrumes

# Toute la configuration est dans /opt/presse-agrumes/config.toml
# (utilisateur du service, permissions 600, mot de passe à changer).
# Si le fichier est ailleurs, utilisez :
#   ExecStart=... presse_agrumes --config /etc/presse-agrumes/config.toml
ExecStart=/opt/presse-agrumes/.venv/bin/python -m presse_agrumes

Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
